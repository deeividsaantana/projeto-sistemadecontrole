rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Reusable general ID validation to prevent resource injection
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to validate the incoming Renea cloud state payload (anti-value poisoning)
    // Each document now stores ONE data type as { value: <list>, updatedAt: <string> }
    // instead of the whole database in a single document (that hit Firestore's
    // 1MB per-document limit). The 'meta' document only carries updatedAt.
    function isValidCloudState(docId, data) {
      return data != null
        && data.updatedAt is string
        && data.updatedAt.size() <= 64
        && (docId == 'meta' || data.value is list || data.value is map);
    }

    // Matches the cloud backup path for the Renea Infraestrutura system
    match /sistemarenea_cloud/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidCloudState(docId, request.resource.data);
      allow delete: if isValidId(docId);
    }
  }
}
