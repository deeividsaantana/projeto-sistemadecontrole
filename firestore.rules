rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Reusable general ID validation to prevent resource injection
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to validate the incoming Renea cloud state payload (anti-value poisoning)
    function isValidCloudState(data) {
      return data != null 
        && data.updatedAt is string 
        && data.updatedAt.size() <= 64
        && data.empresas is list
        && data.obras is list
        && data.equipamentos is list;
    }

    // Legacy single-document backup path. Kept read-only for migration of
    // old backups into the new per-item collections below; the app no
    // longer writes new data here.
    match /sistemarenea_cloud/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidCloudState(request.resource.data);
      allow delete: if isValidId(docId);
    }

    // NOVA ARQUITETURA: cada frota, RDO, relatório, equipamento, lançamento
    // de combustível/lubrificante, ticket etc. é um documento individual
    // dentro da sua própria coleção "sistemarenea_*", em vez de tudo
    // dentro de um único documento. Isso é o que resolve o erro de limite
    // de 1 MiB por documento do Firestore.
    match /{collectionId}/{docId} {
      allow read, write: if isValidId(docId) && collectionId.matches(
        '^sistemarenea_(frotas|rdos|relatorios|equipamentos|combustivel|lubrificantes|tickets|meta|empresas|obras|funcionarios|tipos_combustivel|produtos_lubrificacao|etapas_servico|listas_presenca|ordens_servico|grupos_equipe|presencas_link|historico_presencas|apontamento_ramos|apontamento_ramo_registros|materiais_cadastro|materiais_registros|notifications)$'
      );
    }
  }
}
