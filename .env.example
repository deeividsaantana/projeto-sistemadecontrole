# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Netlify Function - sincronização manutenção externa
# Cole no painel do Netlify como variável de ambiente, NÃO dentro do código.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"sistemaerp-787f6",...}
# Alternativa gerada automaticamente pelo PUBLICAR_TUDO.cmd.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=BASE64_DO_JSON_DA_CONTA_DE_SERVICO
FIREBASE_DATABASE_URL=https://sistemaerp-787f6-default-rtdb.firebaseio.com
MANUTENCAO_SOURCE_URL=https://dynamic-manatee-66561d.netlify.app/
RENEA_PUBLIC_TICKET_LINK_TOKEN=TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES

# Firebase Web SDK - variaveis publicas do navegador. Estas chaves identificam
# o projeto, mas a seguranca real continua em Auth, Firestore Rules e Functions.
VITE_FIREBASE_API_KEY=AIzaSyBPcOluz5J84fdSMRFekHwa-6TCk2ts4K8
VITE_FIREBASE_AUTH_DOMAIN=sistemaerp-787f6.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://sistemaerp-787f6-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=sistemaerp-787f6
VITE_FIREBASE_STORAGE_BUCKET=sistemaerp-787f6.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=333772297925
VITE_FIREBASE_APP_ID=1:333772297925:web:b7ece8323a6ef5e28742ac
VITE_FIREBASE_MEASUREMENT_ID=G-WS7H39BVDR

# Mantido para scripts legados de publicacao, nao e lido pelo navegador Vite.
FIREBASE_WEB_API_KEY=AIzaSyBPcOluz5J84fdSMRFekHwa-6TCk2ts4K8

# Organização padrão usada pelas funções protegidas de cadastros e importações.
