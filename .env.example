# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Netlify Function - sincronização manutenção externa
# Cole variáveis privadas somente no painel do Netlify, NÃO dentro do código.
MANUTENCAO_SOURCE_URL=https://SEU_SITE_DE_MANUTENCAO.netlify.app/
RENEA_PUBLIC_TICKET_LINK_TOKEN=TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES

# Supabase e o backend final do sistema. Variáveis VITE_* são públicas do
# navegador; use apenas URL, chave publicável e identificadores sem segredo.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
VITE_SUPABASE_ORGANIZATION_ID=renea
VITE_SUPABASE_OPERATIONAL_ATTACHMENTS_BUCKET=operational-attachments

# Nunca exponha SUPABASE_SERVICE_ROLE_KEY em variáveis VITE_* ou no navegador.
SUPABASE_SERVICE_ROLE_KEY=CONFIGURE_SOMENTE_NO_NETLIFY_OU_AMBIENTE_SERVIDOR
