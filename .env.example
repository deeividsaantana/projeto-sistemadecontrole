# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# O publicador recusa uma conta de servico de um projeto Firebase diferente do
# configurado abaixo. Baixe a conta de servico do MESMO projeto Firebase da obra.
# Netlify Function - sincronização manutenção externa
# Cole no painel do Netlify como variável de ambiente, NÃO dentro do código.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"SEU_PROJETO_FIREBASE",...}
# Alternativa gerada automaticamente pelo PUBLICAR_TUDO.cmd.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=BASE64_DO_JSON_DA_CONTA_DE_SERVICO
FIREBASE_DATABASE_URL=https://SEU_PROJETO_FIREBASE-default-rtdb.firebaseio.com
MANUTENCAO_SOURCE_URL=https://SEU_SITE_DE_MANUTENCAO.netlify.app/
RENEA_PUBLIC_TICKET_LINK_TOKEN=TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES

# Firebase Web SDK - variaveis publicas do navegador. Estas chaves identificam
# o projeto, mas a seguranca real continua em Auth, Firestore Rules e Functions.
#
# ATENCAO: o pacote do navegador e compilado na maquina que publica, e o Vite le
# estes valores de .env / .env.local na raiz do projeto. Defini-los apenas no
# painel do Netlify nao tem efeito nenhum sobre o site. O PUBLICAR_TUDO.cmd
# escreve .env.local sozinho a partir do que voce informa na primeira execucao.
#
# Confira sempre em: Console do Firebase -> Configuracoes do projeto -> Geral ->
# Seus apps -> app da Web -> Configuracao do SDK.
VITE_FIREBASE_API_KEY=SUBSTITUA_PELA_API_KEY_DO_SEU_PROJETO
VITE_FIREBASE_AUTH_DOMAIN=SEU_PROJETO_FIREBASE.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://SEU_PROJETO_FIREBASE-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=SEU_PROJETO_FIREBASE
VITE_FIREBASE_STORAGE_BUCKET=SEU_PROJETO_FIREBASE.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=SUBSTITUA_PELO_SENDER_ID
VITE_FIREBASE_APP_ID=SUBSTITUA_PELO_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=SUBSTITUA_PELO_MEASUREMENT_ID

# Mantido para scripts legados de publicacao, nao e lido pelo navegador Vite.
FIREBASE_WEB_API_KEY=SUBSTITUA_PELA_API_KEY_DO_SEU_PROJETO

# Organização padrão usada pelas funções protegidas de cadastros e importações.
# Configure somente no painel da Netlify; a conta de serviço Firebase nunca vai ao navegador.
FIREBASE_DEFAULT_ORGANIZATION_ID=renea
