# URL pública da aplicação usada em links e callbacks.
APP_URL="https://seu-dominio.example"

# Organização padrão do ERP.
VITE_SUPABASE_ORGANIZATION_ID=renea

# Configuração pública do Supabase usada pelo navegador.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
VITE_SUPABASE_OPERATIONAL_ATTACHMENTS_BUCKET=operational-attachments

# Nunca exponha SUPABASE_SERVICE_ROLE_KEY em variáveis VITE_* ou no navegador.
# A chave service_role deve existir somente no backend/Render quando necessária.
SUPABASE_SERVICE_ROLE_KEY=CONFIGURE_SOMENTE_NO_BACKEND
