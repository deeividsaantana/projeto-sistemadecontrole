# GEMINI_API_KEY: necessária para leitura inteligente de PDF/foto na Netlify Function.
# Configure no painel do Netlify em:
# Site configuration > Environment variables > Add a variable
# Nome: GEMINI_API_KEY
# Valor: sua chave do Google AI Studio / Gemini API
# Nunca coloque a chave real no código, no GitHub ou em arquivos públicos.
GEMINI_API_KEY="COLE_SUA_CHAVE_APENAS_NO_NETLIFY"

# Alternativa aceita pela Function, se você já usa este nome:
GOOGLE_API_KEY=""

# Modelo opcional. Se ficar vazio, a Function usa gemini-2.5-flash.
GEMINI_DOCUMENT_MODEL="gemini-2.5-flash"

# Restrição opcional de e-mails autorizados a usar a análise inteligente.
# Separe por vírgula. Se ficar vazio, qualquer usuário autenticado no Firebase pode usar.
AI_ALLOWED_EMAILS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Netlify Function - sincronização manutenção externa
# Cole no painel do Netlify como variável de ambiente, NÃO dentro do código.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"sistemarenea",...}
FIREBASE_DATABASE_URL=https://sistemarenea-default-rtdb.firebaseio.com
MANUTENCAO_SOURCE_URL=https://dynamic-manatee-66561d.netlify.app/
