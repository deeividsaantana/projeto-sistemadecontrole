# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Netlify Function - sincronização manutenção externa
# Cole no painel do Netlify como variável de ambiente, NÃO dentro do código.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"sistemarenea",...}
# Alternativa gerada automaticamente pelo PUBLICAR_TUDO.cmd.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=BASE64_DO_JSON_DA_CONTA_DE_SERVICO
FIREBASE_DATABASE_URL=https://sistemarenea-default-rtdb.firebaseio.com
MANUTENCAO_SOURCE_URL=https://dynamic-manatee-66561d.netlify.app/
RENEA_PUBLIC_TICKET_LINK_TOKEN=TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES

# Firebase Web SDK - variaveis publicas do navegador. Estas chaves identificam
# o projeto, mas a seguranca real continua em Auth, Firestore Rules e Functions.
VITE_FIREBASE_API_KEY=SUA_CHAVE_PUBLICA_DO_FIREBASE
VITE_FIREBASE_AUTH_DOMAIN=sistemarenea.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://sistemarenea-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=sistemarenea
VITE_FIREBASE_STORAGE_BUCKET=sistemarenea.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=259137561260
VITE_FIREBASE_APP_ID=1:259137561260:web:835cac33a4a8ba6afaf509
VITE_FIREBASE_MEASUREMENT_ID=G-JJXRKV2FB7

# Mantido para scripts legados de publicacao, nao e lido pelo navegador Vite.
FIREBASE_WEB_API_KEY=SUA_CHAVE_PUBLICA_DO_FIREBASE

# Organização padrão usada pelas funções protegidas de cadastros e importações.
# Configure somente no painel da Netlify; a conta de serviço Firebase nunca vai ao navegador.
FIREBASE_DEFAULT_ORGANIZATION_ID=renea
