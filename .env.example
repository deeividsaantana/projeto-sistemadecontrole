# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API (api/) - configure as credenciais administrativas somente no painel da Render.
SUPABASE_SERVICE_ROLE_KEY=CONFIGURE_NO_RENDER
SUPABASE_URL=https://SEU_PROJETO.supabase.co
MANUTENCAO_SOURCE_URL=https://SEU_SITE_DE_MANUTENCAO/
RENEA_PUBLIC_TICKET_LINK_TOKEN=TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES

VITE_CLOUD_PROVIDER=supabase
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
VITE_SUPABASE_ORGANIZATION_ID=renea
VITE_SUPABASE_OPERATIONAL_ATTACHMENTS_BUCKET=operational-attachments

# Nunca exponha SUPABASE_SERVICE_ROLE_KEY em variáveis VITE_* ou no navegador.
