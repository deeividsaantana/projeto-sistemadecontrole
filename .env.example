# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Netlify Function - sincronização manutenção externa
# Cole no painel do Netlify como variável de ambiente, NÃO dentro do código.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"sistemarenea",...}
# Alternativa gerada automaticamente pelo PUBLICAR_TUDO.cmd.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=BASE64_DO_JSON_DA_CONTA_DE_SERVICO
FIREBASE_DATABASE_URL=https://sistemarenea-default-rtdb.firebaseio.com
MANUTENCAO_SOURCE_URL=https://dynamic-manatee-66561d.netlify.app/
RENEA_PUBLIC_TICKET_LINK_TOKEN=TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES

# Obrigatório para limitar o uso pago da análise por IA.
AI_ALLOWED_EMAILS=admin@empresa.com.br,gestor@empresa.com.br
FIREBASE_WEB_API_KEY=SUA_CHAVE_PUBLICA_DO_FIREBASE

# Fundação PostgreSQL/Supabase v2.1 (opcional e gradual)
# Configure somente no painel do Netlify. A SERVICE_ROLE nunca deve usar prefixo VITE_.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_SOMENTE_NO_SERVIDOR
SUPABASE_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
